APP_NAME=CoPlay
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Set your TMDB API Key
TMDB_API_KEY=

APP_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=spark
# DB_USERNAME=root
# DB_PASSWORD=

# Cache & Queue driver (supported: "sqlite", "redis")
CACHE_DRIVER=sqlite
QUEUE_DRIVER=sqlite

# Shared Redis connection config (used by Cache, Queue, and Lock)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0
REDIS_PREFIX=spark
REDIS_TIMEOUT=0.0
REDIS_READ_TIMEOUT=0.0
REDIS_PERSISTENT=false
